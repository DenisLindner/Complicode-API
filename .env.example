NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
DATABASE_URL="postgres://denis:root@localhost:5432/complicode"

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=complicode
KEYCLOAK_CLIENT_ID=complicode-api
KEYCLOAK_CLIENT_SECRET=complicode-dev-secret

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Complicode <no-reply@complicode.dev>"

# console (dev: prints the code in the logs) | meta (WhatsApp Cloud API)
WHATSAPP_PROVIDER=console
WHATSAPP_META_API_VERSION=v23.0
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_TEMPLATE_NAME=verification_code
WHATSAPP_META_TEMPLATE_LANGUAGE=pt_BR

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# https://docs.abacatepay.com (use the dev mode key while testing)
ABACATEPAY_API_URL=https://api.abacatepay.com/v2
ABACATEPAY_API_KEY=
# secret registered on the webhook (sent back as ?webhookSecret=)
ABACATEPAY_WEBHOOK_SECRET=
# id of the "10 créditos" product (R$ 10,00) created in the dashboard
ABACATEPAY_CREDITS_PRODUCT_ID=

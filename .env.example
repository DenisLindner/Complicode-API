NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
DATABASE_URL="postgres://denis:root@localhost:5432/complicode"

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=complicode
KEYCLOAK_CLIENT_ID=complicode-api
KEYCLOAK_CLIENT_SECRET=complicode-dev-secret

# dev: mailpit (localhost:1025). production: Gmail SMTP with an app password
# (smtp.gmail.com, port 465, SMTP_SECURE=true), limited to ~500 emails/day
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Complicode <no-reply@complicode.dev>"

# Telegram bot that verifies the phone (create it with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# polling (dev, no public URL needed) | webhook (production) | disabled
TELEGRAM_UPDATES_MODE=polling
# webhook mode only: public HTTPS URL of /api/webhooks/telegram and a secret (A-Z, a-z, 0-9, _ and -)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# comma-separated models tried when the primary one fails or is overloaded
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest

# https://docs.abacatepay.com (use the dev mode key while testing)
ABACATEPAY_API_URL=https://api.abacatepay.com/v2
ABACATEPAY_API_KEY=
# secret registered on the webhook (sent back as ?webhookSecret=)
ABACATEPAY_WEBHOOK_SECRET=
# id of the "10 créditos" product (R$ 10,00) created in the dashboard
ABACATEPAY_CREDITS_PRODUCT_ID=

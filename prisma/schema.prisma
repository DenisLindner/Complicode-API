// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ChallengeStatus {
  GENERATING
  READY
  FAILED
}

model Challenge {
  id                String          @id @default(uuid(7))
  userId            String
  stackId           String
  frameworkId       String
  level             ChallengeLevel
  status            ChallengeStatus @default(GENERATING)
  title             String?
  context           String?
  description       String?
  technologies      String[]
  deliverables      String[]
  public            Boolean         @default(false)
  regenerationsUsed Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stack     Stack              @relation(fields: [stackId], references: [id])
  framework Framework          @relation(fields: [frameworkId], references: [id])
  versions  ChallengeVersion[]

  @@index([userId, createdAt])
  @@index([public, status, createdAt])
  @@map("challenges")
}

model ChallengeVersion {
  id           String   @id @default(uuid(7))
  challengeId  String
  version      Int
  title        String
  context      String
  description  String
  technologies String[]
  deliverables String[]
  model        String

  createdAt DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, version])
  @@map("challenge_versions")
}

model User {
  id            String  @id @default(uuid(7))
  keycloakId    String  @unique
  name          String
  email         String  @unique
  phone         String? @unique
  telegramId    String? @unique
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)
  credits       Int     @default(0)

  creditTransactions CreditTransaction[]
  verificationCodes  VerificationCode[]
  challenges         Challenge[]
  payments           Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum CreditTransactionType {
  SIGNUP_BONUS
  PURCHASE
  CHALLENGE_GENERATION
  REFUND
  PURCHASE_REFUND
}

model CreditTransaction {
  id           String                @id @default(uuid(7))
  userId       String
  type         CreditTransactionType
  amount       Int
  balanceAfter Int
  referenceId  String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, referenceId])
  @@index([userId, createdAt])
  @@map("credit_transactions")
}

enum VerificationChannel {
  EMAIL
  PHONE
}

model VerificationCode {
  id         String              @id @default(uuid(7))
  userId     String
  channel    VerificationChannel
  /// Email address, or the verified phone once the Telegram contact arrives.
  target     String?
  codeHash   String
  /// Telegram user id that opened the deep link (phone channel).
  externalId String?
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel])
  @@index([codeHash])
  @@index([externalId])
  @@map("verification_codes")
}

enum ChallengeLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
}

model Stack {
  id   String @id @default(uuid(7))
  slug String @unique
  name String

  frameworks Framework[]
  challenges Challenge[]

  @@map("stacks")
}

model Framework {
  id       String  @id @default(uuid(7))
  slug     String  @unique
  name     String
  language String
  active   Boolean @default(true)

  stacks     Stack[]
  challenges Challenge[]

  @@map("frameworks")
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

model Payment {
  id          String        @id @default(uuid(7))
  userId      String
  providerId  String?       @unique
  checkoutUrl String?
  status      PaymentStatus @default(PENDING)
  amountCents Int
  credits     Int
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("payments")
}

model WebhookEvent {
  id          String   @id
  provider    String
  event       String
  payload     Json
  processedAt DateTime @default(now())

  @@map("webhook_events")
}
